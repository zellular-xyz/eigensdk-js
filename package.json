{
	"name": "eigensdk",
	"version": "0.0.1",
	"description": "Js SDK for building AVSs on Eigenlayer",
    "main": "./src/index.ts",
	"types": "src/index.ts",
	"files": [
		"src/**/*"
	],
	"exports": {
		".": "./src/index.ts",
        "./chainio/*": "./src/chainio/*.ts",
        "./crypto/*": "./src/crypto/*.ts",
        "./contracts/*": "./src/contracts/*.ts",
        "./contracts/*.json": "./src/contracts/*.json",
        "./types/*": "./src/types/*.ts",
        "./utils/*": "./src/utils/*.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"format": "dprint fmt",
		"lint": "run-p lint:*",
		"lint:format": "dprint check",
		"lint:types": "tsc",
		"lint:js": "eslint .",
		"test": "vitest"
	},
	"dependencies": {
		"ethereumjs-tx": "^2.1.2",
		"ethers": "^6.12.1",
		"fastify": "^4.28.0",
		"js-yaml": "^4.1.0",
		"mcl-wasm": "^1.5.0",
		"pino": "^9.2.0",
		"pino-pretty": "^13.0.0",
		"prom-client": "^15.1.2",
		"web3": "^4.9.0"
	},
	"devDependencies": {
		"@sachinraja/eslint-config": "0.3.0",
		"@types/node": "20.5.0",
		"dprint": "0.40.2",
		"eslint": "8.47.0",
		"npm-run-all": "4.1.5",
		"ts-node": "^10.9.2",
		"tsup": "7.2.0",
		"typescript": "5.1.6",
		"vite": "4.4.9",
		"vitest": "0.34.1"
	},
	"sideEffects": false,
	"packageManager": "pnpm@8.15.8"
}
